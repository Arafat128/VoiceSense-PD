# Copy this file to .env. Never commit a real key.
# Set one key. If both are set, OpenAI is used unless the provider says otherwise.

OPENAI_API_KEY=
XAI_API_KEY=

# auto, openai, or xai. auto uses OpenAI when OPENAI_API_KEY is set, otherwise xAI.
# VOICESENSE_ASSISTANT_PROVIDER=auto

# Overrides the model for whichever provider is selected.
# Defaults: gpt-4o-mini for OpenAI, grok-4 for xAI.
# VOICESENSE_ASSISTANT_MODEL=
