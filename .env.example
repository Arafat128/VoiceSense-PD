# Copy to .env (never commit .env). Used only for optional Primus enrollment.
# Voice screening does not read these variables.

PRIMUS_APP_ID=
# Local test-mode request signing only. Do not put this in a public hosted app.
PRIMUS_APP_SECRET=

# GitHub / X / similar ownership template from https://dev.primuslabs.xyz/
PRIMUS_UNIQUENESS_TEMPLATE_ID=
# Field name inside that template (X: screen_name, GitHub: login, …)
PRIMUS_IDENTITY_FIELD=screen_name

# Optional boolean age/eligibility template
PRIMUS_AGE_TEMPLATE_ID=
PRIMUS_AGE_FIELD=age
PRIMUS_AGE_OP=>=
PRIMUS_AGE_VALUE=18

# 1 = show a "simulate enrollment" button (not a real zkTLS proof)
PRIMUS_MOCK=0
